# Auto-detect text files and normalize
* text=auto

# Source code and config should stay LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Shell scripts on LF
*.sh text eol=lf

# Windows scripts on CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
